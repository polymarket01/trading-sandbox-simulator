    "SPOT",
    "PERP"
  ],
  "account_slots": 1,
  "executor": "managed",
  "entrypoints": {
    "default": "app.maker_strategies.simple_bbo.plugin:default_config",
    "validate": "app.maker_strategies.simple_bbo.plugin:validate",
    "preview": "app.maker_strategies.simple_bbo.plugin:preview",
    "worker": "app.maker_strategies.simple_bbo.plugin:SimpleBBOWorker"
  },
  "parameters": [
    {
      "path": "second_level_notional",
      "label": "二档每侧金额（USDT）",
