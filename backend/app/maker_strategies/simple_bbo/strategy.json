      "exclusive_minimum": "0",
      "default": "1000000"
    },
    {
      "path": "second_level_distance_bps",
      "label": "二档距离（bps）",
      "kind": "decimal",
      "exclusive_minimum": "0",
      "exclusive_maximum": "10000",
      "default": "5"
    }
